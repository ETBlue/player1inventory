{
  // Root Biome config. It covers `e2e/` and nothing else.
  //
  // IT MUST STAY A `.jsonc` FILE. Biome reads comments in `biome.jsonc` and
  // SILENTLY IGNORES a `biome.json` that contains any — no error, no warning,
  // and it falls back to its own built-in defaults. Found 2026-10-11: as
  // `biome.json` with these comments, `biome lint ./e2e` checked 59 files
  // instead of 54 (it picked up `e2e/fixtures/*.json` and the two tsconfigs)
  // and `biome check ./e2e` reported 79 formatting errors in tabs and double
  // quotes, which is Biome's default style and not this repo's. The lint count
  // was unchanged at 13, because the rule set happened to match — so the lint
  // output alone does not reveal the problem. Check the FILE COUNT.
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "files": {
    // `e2e/` ONLY. `apps/web` has its own `biome.json` and is untouched by this
    // file — verified by running `(cd apps/web && pnpm check)` with and without
    // it: 628 files, 4 warnings, both times (re-measured 2026-10-30; it said
    // 627 when this file was written on 2026-10-11).
    //
    // Before this file existed nothing linted `e2e/` (issue #322): both root
    // scripts were `pnpm --filter web …`, and `apps/web/biome.json` scopes
    // itself to `src/**`.
    "includes": ["e2e/**/*.ts"]
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  // Formatter and import sorting are ON since 2026-10-30 (issue #346). They
  // were off for 19 days, from the day this file was created (issue #322) to
  // the day `e2e/` was swept.
  //
  // `e2e/` was written with no formatter, so turning them on rewrote almost all
  // of it in one commit: 1699 insertions and 684 deletions across 46 of 54
  // files, nearly all of it line rewrapping at the default 80-column width.
  // Before the sweep `biome check ./e2e` reported 65 errors — 45 `format` and
  // 20 `assist/source/organizeImports`. (This file said 64 / 44 / 20 when it
  // was written on 2026-10-11; one spec was added in between. Measure, do not
  // quote.)
  //
  // The sweep changed no behaviour, and that was checked rather than assumed.
  // Every one of the 46 files is AST-identical outside its import block, and no
  // import binding changed anywhere — same modules, same names. 11 files had
  // their import statements reordered, which is safe here because no `e2e/`
  // module runs code at import time: the only top-level statements that are not
  // declarations are the `test(...)` and `test.describe(...)` registrations in
  // the spec files, and no spec file is imported by anything.
  //
  // The settings below match `apps/web/biome.json` exactly, so one style covers
  // the whole repo.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  }
}
