generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TargetUnit {
  package
  measurement
}

enum ExpirationMode {
  disabled
  date
  days_from_purchase
}

enum TagColor {
  red
  orange
  yellow
  green
  teal
  cyan
  blue
  indigo
  purple
  pink
  gray
}

model TagType {
  id          String   @id @default(cuid())
  name        String
  color       TagColor
  householdId String

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tags      Tag[]

  @@index([householdId, name])
}

model Tag {
  id          String  @id @default(cuid())
  name        String
  typeId      String
  householdId String
  parentId    String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // NoAction, not the default Restrict (households H3a). Deleting a household
  // deletes its tag types and its tags in one statement, by two cascades.
  // NO ACTION refuses only if a tag still names the deleted type when the
  // check runs. A type that still has tags still cannot be deleted on its own,
  // so deleteTagType behaves as before. Not Cascade: that would let one account
  // delete another account's tags through a shared typeId.
  type      TagType   @relation(fields: [typeId], references: [id], onDelete: NoAction)
  parent    Tag?      @relation("TagHierarchy", fields: [parentId], references: [id])
  children  Tag[]     @relation("TagHierarchy")
  items     ItemTag[]

  @@index([householdId, typeId])
}

model Vendor {
  id          String @id @default(cuid())
  name        String
  householdId String

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ItemVendor[]

  @@index([householdId, name])
}

model Item {
  id                  String         @id @default(cuid())
  name                String
  // Full URL to the Wikidata entity. Optional, non-indexed. Mirrors the local
  // Dexie `Item` (packages/types/src/index.ts) so the two data modes match.
  wikidataUrl         String?
  // Free-text note about the item. Optional, non-indexed.
  note                String?
  packageUnit         String?
  measurementUnit     String?
  amountPerPackage    Float?
  targetUnit          TargetUnit
  consumeAmount       Float          @default(1)
  estimatedDueDays    Int?
  expirationThreshold Int?
  expirationMode      ExpirationMode @default(disabled)
  householdId         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tags          ItemTag[]
  vendors       ItemVendor[]
  recipes       RecipeItem[]
  inventoryLogs InventoryLog[]
  cartItems     CartItem[]
  itemStocks    ItemStock[]

  @@index([householdId, updatedAt])
  @@index([householdId, name])
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

model ItemVendor {
  itemId   String
  vendorId String

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([itemId, vendorId])
}

model Recipe {
  id           String    @id @default(cuid())
  name         String
  lastCookedAt DateTime?
  householdId  String

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     RecipeItem[]

  @@index([householdId, name])
}

model RecipeItem {
  recipeId      String
  itemId        String
  defaultAmount Float

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([recipeId, itemId])
}

model Cart {
  id              String    @id
  // No "userId" since households H3b (migration 20261114000000_shared_carts).
  // A cart belongs to its location, and everyone with a role on that location
  // shares it. Who may read or write a cart is decided by the location role
  // (lib/authz.ts: requireCartLocation, locationIdsWithRole), never by who
  // made the cart.
  // The location this cart belongs to. Added in PR 3a, written by every cart
  // writer. PR 3b re-keyed Cart.id to `${locationId}:${vendorId}`, which is what
  // the resolvers look a cart up by; this column is what `bootstrapCarts`
  // queries by to return one location's carts.
  //
  // Since PR 3c it is also read THROUGH CartItem, as the relation filter
  // `where: { cart: { locationId } }` — `cartItemCountByItem` and
  // `removeItemFromLocation`'s cascade both use it. There is still NO
  // standalone index on this column (see the PR 3a migration, which says so on
  // purpose). Those two queries are driven by `CartItem_itemId_idx` and reach
  // `Cart` by its primary key, and a user holds few carts, so an index was not
  // added. Add one if a query ever filters `Cart` by `locationId` alone over
  // many rows.
  //
  // onDelete: Cascade. Deleting a location deletes its carts, which matches
  // local mode: deleteLocation in apps/web/src/db/operations.ts:1215 deletes
  // the location's carts and their cart items. CartItem already cascades from
  // Cart, so one cascade removes both. Restrict was the alternative and is
  // worse here: deleteLocation refuses no location since households H5 task
  // F.7 (it refused the household's last one from H3a, and only the default
  // one before that), so Restrict would turn deleting any location with a
  // cart into a raw P2003 foreign-key error the resolver does not handle.
  locationId      String
  lastPurchasedAt DateTime?

  location Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id       String @id @default(cuid())
  cartId   String
  itemId   String
  quantity Float
  // Who added the row ("added by"). Since households H3b it is never a scope:
  // no cart read or write filters by it. It is written only when a row is
  // created, and it is kept when another person's add is merged into the row.
  userId   String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // One row per item per cart (households H3b). Two adds of the same item
  // to the same cart add up in one row. This index starts with "cartId", so
  // it also serves every lookup by "cartId" alone, and the old
  // @@index([cartId]) was dropped.
  @@unique([cartId, itemId])
  @@index([itemId])
}

model InventoryLog {
  id         String   @id @default(cuid())
  itemId     String
  delta      Float
  quantity   Float
  occurredAt DateTime
  userId     String
  // The location the log was written against. Added in PR 3a.
  //
  // onDelete: Cascade, same reason as Cart above: a log records stock movement
  // at one place, so it means nothing once that place is gone. Local mode
  // already does this — deleteLocation deletes the location's inventory logs
  // (apps/web/src/db/operations.ts:1225).
  locationId String
  note       String?
  logKey     String?
  logParams  Json?

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Serves the three location-scoped log queries (PR 3a, Task 2): itemLogs,
  // inventoryLogCountByItem and lastPurchaseDates. All three match itemId and
  // locationId for equality, then order by or count occurredAt. Both equality
  // columns lead, so occurredAt is already ordered inside each match; Postgres
  // reads a Desc index backwards, so `orderBy: { occurredAt: 'asc' }` in
  // itemLogs is served too.
  @@index([itemId, locationId, occurredAt(sort: Desc)])
  // Kept from before PR 3a. After Task 2 no query filters itemId without also
  // filtering locationId, so this index has no remaining reader. Dropping an
  // index is destructive and PR 3a is the additive PR, so it stays for now.
  @@index([itemId, occurredAt(sort: Desc)])
}

model Shelf {
  id           String   @id @default(cuid())
  name         String
  type         String
  order        Int
  filterConfig Json?
  itemIds      String[]
  householdId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, order])
}

model Location {
  id          String   @id @default(cuid())
  name        String
  order       Int
  // No `isDefault` and no `userId` since the drop_user_scope migration
  // (households H3a task 3.14). A location belongs to a household, and a
  // person's rights on it come from LocationMember.
  householdId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household     Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  members       LocationMember[]
  itemStocks    ItemStock[]
  inventoryLogs InventoryLog[]
  carts         Cart[]

  @@index([householdId, order])
}

// Per-(item × location) stock STATE. Configuration (units, packaging,
// expiration mode, consume amount) lives on Item and does not vary by location.
//
// Deliberately has NO userId and no householdId: an ItemStock is scoped
// through its location, by `requireLocationRole` (lib/authz.ts). It was
// `where: { location: { userId } }` until households H3a. A scope column here
// would put `stock.userId === ctx.userId` within reach at every call site —
// the guard the RBAC design forbids.
model ItemStock {
  id               String    @id @default(cuid())
  itemId           String
  locationId       String
  targetQuantity   Float     @default(0)
  refillThreshold  Float     @default(0)
  packedQuantity   Float     @default(0)
  unpackedQuantity Float     @default(0)
  dueDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([locationId])
}

// A person who has signed in with Clerk. The server keeps the name and email
// here so it does not have to ask Clerk on every request. The Clerk webhook
// fills it (households H2); see
// docs/global/permissions/2026-10-04-households-design.md.
//
// Households H3a adds the relations to Household, HouseholdMember and
// LocationMember. Location and the six catalog models have no `userId` since
// the drop_user_scope migration (task 3.14): they belong to a household.
// Cart, CartItem and InventoryLog keep a plain `userId` string (the author)
// with no relation to User.
model User {
  // The Clerk user id. Since H2 the webhook and ensureUser create this row
  // before first sign-in runs, so this key cannot be the first sign-in race
  // guard. householdSetupAt below is (decision H1).
  id                String     @id
  displayName       String
  // Optional: a Clerk account may sign in by phone or username, and the
  // user.deleted event carries no email.
  email             String?
  lastSeenAt        DateTime?
  deletedAt         DateTime?
  // The first sign-in claim (decision H1). Null means this person has never
  // had a household set up. First sign-in runs
  //   updateMany({ where: { id, householdSetupAt: null }, data: { householdSetupAt: now } })
  // as the first statement of its transaction. A count of 1 means this request
  // creates the household; 0 means another request already did. It also tells
  // "never set up" apart from "left their household" (H5), so leaving does not
  // make a new household.
  householdSetupAt  DateTime?
  // The household this person last chose (households H5b, decision T14).
  // Null for every person when this column is added, and after the household
  // is deleted (SetNull). The server reads it only while the person is still a
  // member there. Otherwise it falls back to the OLDEST membership by
  // joinedAt, then householdId, so null needs no backfill and every request
  // gives the same answer. Joining or creating a household sets it.
  activeHouseholdId String?
  activeHousehold   Household? @relation("ActiveHousehold", fields: [activeHouseholdId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Households whose ownerId is this person. Named, because the relation from
  // Household to User is not the only path between them: HouseholdMember joins
  // them too. The name keeps the two apart for a reader.
  ownedHouseholds      Household[]       @relation("HouseholdOwner")
  householdMemberships HouseholdMember[]
  locationMemberships  LocationMember[]
  // Invites this person made, and invites this person used (decision T26).
  // Named, because HouseholdInvite points at User twice.
  invitesCreated       HouseholdInvite[] @relation("InviteCreatedBy")
  invitesUsed          HouseholdInvite[] @relation("InviteUsedBy")

  // Serves the ON DELETE SET NULL on activeHouseholdId, which Postgres runs
  // as a lookup by that column when a household is deleted.
  @@index([activeHouseholdId])
}

enum HouseholdRole {
  owner
  manager
  member
}

enum LocationRole {
  organizer
  participant
  viewer
}

// A group of people who share a catalog and locations. Households H3a. See
// docs/global/permissions/2026-10-04-households-design.md.
model Household {
  id          String    @id @default(cuid())
  name        String
  // Mirrors the HouseholdMember row with role owner, and is written in the same
  // transaction as that row (decision H15). The member row is the source of
  // truth for rights. Null after the owner's account is deleted, until someone
  // accepts the hand-over (H6).
  ownerId     String?
  owner       User?     @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerGoneAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members    HouseholdMember[]
  locations  Location[]
  items      Item[]
  tags       Tag[]
  tagTypes   TagType[]
  vendors    Vendor[]
  recipes    Recipe[]
  shelves    Shelf[]
  // People whose active household this is (decision T14). Named, because
  // "HouseholdOwner" already joins Household and User.
  activeFor  User[]              @relation("ActiveHousehold")
  // Open, used and revoked invites. Deleted with the household (Cascade).
  invites    HouseholdInvite[]
  // Who changed what in the household (H6). Deleted with the household
  // (Cascade).
  activities HouseholdActivity[]

  // Finds "the households this person owns", and serves the ON DELETE SET
  // NULL above, which Postgres runs as a lookup by ownerId.
  @@index([ownerId])
}

// A person's role in a household. The source of truth for household rights.
// At most one owner row per household: the add_households migration creates
// the partial unique index HouseholdMember_one_owner_key by hand, because
// Prisma has no syntax for a partial index (decision H15).
//
// The `user` relation has no onDelete, so Prisma's default (Restrict) applies:
// a User row that still has member rows cannot be deleted. Production never
// deletes a User row (H2 sets deletedAt), so such a delete is a bug and should
// fail loudly. /e2e/cleanup deletes the member rows first.
model HouseholdMember {
  householdId String
  userId      String
  role        HouseholdRole
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@id([householdId, userId])
  @@index([userId])
}

// A person's role on one location. It counts only while the person is also a
// HouseholdMember of the location's household (decision H18). Postgres cannot
// check that with a simple constraint, so requireLocationRole checks it.
// No onDelete on `user`, for the same reason as HouseholdMember.
model LocationMember {
  locationId String
  userId     String
  role       LocationRole
  createdAt  DateTime     @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([locationId, userId])
  @@index([userId])
}

// An invite link to a household (households H5b, decision T26). See
// docs/global/permissions/2026-10-04-households-design.md, *Invite and join*,
// and docs/global/permissions/2026-11-18-households-plan-h5b.md.
//
// One invite can be used once. It is claimed with a conditional updateMany
// (usedAt null, revokedAt null, expiresAt in the future), so two joins with
// one token cannot both win (decision T17).
model HouseholdInvite {
  id            String        @id @default(cuid())
  householdId   String
  // 32 random bytes, base64url (decision T12). Secret: never logged. Stored
  // plainly, so the owner or a manager can copy an open link again (O7-A).
  token         String        @unique
  householdRole HouseholdRole
  // A JSON list of { locationId, role }. Read through a checked parser every
  // time. A list, not a child table: an invite that names a location deleted
  // since must still be readable.
  locationRoles Json
  // No onDelete, so Prisma's default (Restrict) applies, the same as the
  // member tables: deleting a User who made an invite is a bug and fails
  // loudly. /e2e/cleanup deletes the invites first.
  createdById   String
  createdAt     DateTime      @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  // History only, so it may be lost: SetNull when the User row is deleted.
  usedById      String?
  revokedAt     DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedBy    User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  // Lists a household's invites, and serves the ON DELETE CASCADE above.
  @@index([householdId])
}

// What a row of the household activity log records (households H6, decision
// T51 of docs/global/permissions/2026-11-20-households-plan-h6.md). An enum,
// so a typo fails at `tsc` (decision H14). The H6b values are here too, so H6b
// needs no `ALTER TYPE ... ADD VALUE`.
enum ActivityAction {
  LOCATION_ROLE_SET
  LOCATION_ROLE_REMOVED
  LOCATION_LEFT
  HOUSEHOLD_ROLE_CHANGED
  INVITE_CREATED
  INVITE_REVOKED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  HOUSEHOLD_CLEARED
  LOCATIONS_DELETED
  LOCATION_ITEMS_REMOVED
  IMPORT
  OWNERSHIP_OFFERED
  OWNERSHIP_OFFER_CANCELLED
  OWNERSHIP_DECLINED
  OWNERSHIP_ACCEPTED
  HANDOVER_STARTED
  ACCOUNT_DELETED
}

// One row of the household activity log (households H6, decision T46). Owners
// and managers read it, newest first. Written only by `recordActivity`
// (lib/activity.ts), inside the transaction of the change it describes
// (decision T47).
//
// Only `householdId` is a foreign key. A log must outlive the person and the
// location it names, so `actorId`, `targetUserId` and `locationId` are plain
// strings:
//   - a foreign key to `Location` would delete the row with the location
//     (Cascade), lose which location it was (SetNull), or block the delete
//     (Restrict);
//   - a foreign key to `User` would block `/e2e/cleanup`, which deletes
//     `User` rows, whenever a row in ANOTHER household names the person.
// The location's name is stored in `details` at write time, for the same
// reason.
model HouseholdActivity {
  id           String         @id @default(cuid())
  householdId  String
  // The person who acted. For a hand-over (H6b) it is the deleted person
  // (decision T50).
  actorId      String
  action       ActivityAction
  // The person the change is about, when there is one.
  targetUserId String?
  // The location the change is about, when there is one.
  locationId   String?
  // Extra facts for the sentence on the Activity page, such as
  // `{ from, to }` or `locationName`. Shape per action: decision T51.
  details      Json?
  createdAt    DateTime       @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // The Activity page reads one household, newest first, with `id` to break
  // a tie (decision T54). It also serves the ON DELETE CASCADE.
  @@index([householdId, createdAt(sort: Desc), id])
}
