generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TargetUnit {
  package
  measurement
}

enum ExpirationMode {
  disabled
  date
  days_from_purchase
}

enum TagColor {
  red
  orange
  yellow
  green
  teal
  cyan
  blue
  indigo
  purple
  pink
  gray
}

model TagType {
  id          String   @id @default(cuid())
  name        String
  color       TagColor
  userId      String
  // Households H3a. Nullable until the drop_user_scope migration (task 3.14)
  // sets it NOT NULL and drops userId. See the add_households migration.
  householdId String?

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tags      Tag[]

  @@index([userId, name])
  @@index([householdId, name])
}

model Tag {
  id          String  @id @default(cuid())
  name        String
  typeId      String
  userId      String
  // Households H3a. Nullable until the drop_user_scope migration (task 3.14)
  // sets it NOT NULL and drops userId. See the add_households migration.
  householdId String?
  parentId    String?

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  type      TagType    @relation(fields: [typeId], references: [id])
  parent    Tag?       @relation("TagHierarchy", fields: [parentId], references: [id])
  children  Tag[]      @relation("TagHierarchy")
  items     ItemTag[]

  @@index([userId, typeId])
  @@index([householdId, typeId])
}

model Vendor {
  id          String  @id @default(cuid())
  name        String
  userId      String
  // Households H3a. Nullable until the drop_user_scope migration (task 3.14)
  // sets it NOT NULL and drops userId. See the add_households migration.
  householdId String?

  household Household?   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ItemVendor[]

  @@index([userId, name])
  @@index([householdId, name])
}

model Item {
  id                  String         @id @default(cuid())
  name                String
  // Full URL to the Wikidata entity. Optional, non-indexed. Mirrors the local
  // Dexie `Item` (packages/types/src/index.ts) so the two data modes match.
  wikidataUrl         String?
  // Free-text note about the item. Optional, non-indexed.
  note                String?
  packageUnit         String?
  measurementUnit     String?
  amountPerPackage    Float?
  targetUnit          TargetUnit
  consumeAmount       Float          @default(1)
  estimatedDueDays    Int?
  expirationThreshold Int?
  expirationMode      ExpirationMode @default(disabled)
  userId              String
  // Households H3a. Nullable until the drop_user_scope migration (task 3.14)
  // sets it NOT NULL and drops userId. See the add_households migration.
  householdId         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  household     Household?     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tags          ItemTag[]
  vendors       ItemVendor[]
  recipes       RecipeItem[]
  inventoryLogs InventoryLog[]
  cartItems     CartItem[]
  itemStocks    ItemStock[]

  @@index([userId, updatedAt])
  @@index([userId, name])
  @@index([householdId, updatedAt])
  @@index([householdId, name])
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

model ItemVendor {
  itemId   String
  vendorId String

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([itemId, vendorId])
}

model Recipe {
  id           String    @id @default(cuid())
  name         String
  lastCookedAt DateTime?
  userId       String
  // Households H3a. Nullable until the drop_user_scope migration (task 3.14)
  // sets it NOT NULL and drops userId. See the add_households migration.
  householdId  String?

  household Household?   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     RecipeItem[]

  @@index([userId, name])
  @@index([householdId, name])
}

model RecipeItem {
  recipeId      String
  itemId        String
  defaultAmount Float

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([recipeId, itemId])
}

model Cart {
  id              String    @id
  userId          String
  // The location this cart belongs to. Added in PR 3a, written by every cart
  // writer. PR 3b re-keyed Cart.id to `${locationId}:${vendorId}`, which is what
  // the resolvers look a cart up by; this column is what `bootstrapCarts`
  // queries by to return one location's carts.
  //
  // Since PR 3c it is also read THROUGH CartItem, as the relation filter
  // `where: { cart: { locationId } }` — `cartItemCountByItem` and
  // `removeItemFromLocation`'s cascade both use it. There is still NO
  // standalone index on this column (see the PR 3a migration, which says so on
  // purpose). Those two queries are driven by `CartItem_itemId_idx` and reach
  // `Cart` by its primary key, and a user holds few carts, so an index was not
  // added. Add one if a query ever filters `Cart` by `locationId` alone over
  // many rows.
  //
  // onDelete: Cascade. Deleting a location deletes its carts, which matches
  // local mode: deleteLocation in apps/web/src/db/operations.ts:1215 deletes
  // the location's carts and their cart items. CartItem already cascades from
  // Cart, so one cascade removes both. Restrict was the alternative and is
  // worse here: deleteLocation already refuses only the default location, so
  // Restrict would turn deleting any location with a cart into a raw P2003
  // foreign-key error the resolver does not handle.
  locationId      String
  lastPurchasedAt DateTime?

  location Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([userId])
}

model CartItem {
  id       String @id @default(cuid())
  cartId   String
  itemId   String
  quantity Float
  userId   String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([itemId])
}

model InventoryLog {
  id         String   @id @default(cuid())
  itemId     String
  delta      Float
  quantity   Float
  occurredAt DateTime
  userId     String
  // The location the log was written against. Added in PR 3a.
  //
  // onDelete: Cascade, same reason as Cart above: a log records stock movement
  // at one place, so it means nothing once that place is gone. Local mode
  // already does this — deleteLocation deletes the location's inventory logs
  // (apps/web/src/db/operations.ts:1225).
  locationId String
  note       String?
  logKey     String?
  logParams  Json?

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Serves the three location-scoped log queries (PR 3a, Task 2): itemLogs,
  // inventoryLogCountByItem and lastPurchaseDates. All three match itemId and
  // locationId for equality, then order by or count occurredAt. Both equality
  // columns lead, so occurredAt is already ordered inside each match; Postgres
  // reads a Desc index backwards, so `orderBy: { occurredAt: 'asc' }` in
  // itemLogs is served too.
  @@index([itemId, locationId, occurredAt(sort: Desc)])
  // Kept from before PR 3a. After Task 2 no query filters itemId without also
  // filtering locationId, so this index has no remaining reader. Dropping an
  // index is destructive and PR 3a is the additive PR, so it stays for now.
  @@index([itemId, occurredAt(sort: Desc)])
}

model Shelf {
  id           String   @id @default(cuid())
  name         String
  type         String
  order        Int
  filterConfig Json?
  itemIds      String[]
  userId       String
  // Households H3a. Nullable until the drop_user_scope migration (task 3.14)
  // sets it NOT NULL and drops userId. See the add_households migration.
  householdId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([userId, order])
  @@index([householdId, order])
}

model Location {
  id          String   @id @default(cuid())
  name        String
  order       Int
  // Exactly one per user. NOT derivable from `order`: dnd-kit's `disabled`
  // stops the default row being dragged but not from being displaced by
  // another row dropped above it, so lowest-order is not stable.
  // A partial unique index enforces the invariant — see the migration.
  isDefault   Boolean  @default(false)
  userId      String
  // Households H3a. Nullable until the drop_user_scope migration (task 3.14)
  // sets it NOT NULL and drops userId. See the add_households migration.
  householdId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household     Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  members       LocationMember[]
  itemStocks    ItemStock[]
  inventoryLogs InventoryLog[]
  carts         Cart[]

  @@index([userId, order])
  @@index([householdId, order])
}

// Per-(item × location) stock STATE. Configuration (units, packaging,
// expiration mode, consume amount) lives on Item and does not vary by location.
//
// Deliberately has NO userId: an ItemStock is scoped through its location
// (`where: { location: { userId } }`), the shape location RBAC needs. A userId
// column would put `stock.userId === ctx.userId` within reach at every call
// site — the guard the RBAC design forbids.
model ItemStock {
  id               String    @id @default(cuid())
  itemId           String
  locationId       String
  targetQuantity   Float     @default(0)
  refillThreshold  Float     @default(0)
  packedQuantity   Float     @default(0)
  unpackedQuantity Float     @default(0)
  dueDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([locationId])
}

// A person who has signed in with Clerk. The server keeps the name and email
// here so it does not have to ask Clerk on every request. The Clerk webhook
// fills it (households H2); see
// docs/global/permissions/2026-10-04-households-design.md.
//
// Households H3a adds the relations to Household, HouseholdMember and
// LocationMember. The seven models that still carry a plain `userId` string
// (Location and the six catalog models) have no relation to User: that column
// is dropped in the drop_user_scope migration (task 3.14).
model User {
  // The Clerk user id. Since H2 the webhook and ensureUser create this row
  // before first sign-in runs, so this key cannot be the first sign-in race
  // guard. householdSetupAt below is (decision H1).
  id               String    @id
  displayName      String
  // Optional: a Clerk account may sign in by phone or username, and the
  // user.deleted event carries no email.
  email            String?
  lastSeenAt       DateTime?
  deletedAt        DateTime?
  // The first sign-in claim (decision H1). Null means this person has never
  // had a household set up. First sign-in runs
  //   updateMany({ where: { id, householdSetupAt: null }, data: { householdSetupAt: now } })
  // as the first statement of its transaction. A count of 1 means this request
  // creates the household; 0 means another request already did. It also tells
  // "never set up" apart from "left their household" (H5), so leaving does not
  // make a new household.
  householdSetupAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Households whose ownerId is this person. Named, because the relation from
  // Household to User is not the only path between them: HouseholdMember joins
  // them too. The name keeps the two apart for a reader.
  ownedHouseholds      Household[]       @relation("HouseholdOwner")
  householdMemberships HouseholdMember[]
  locationMemberships  LocationMember[]
}

enum HouseholdRole {
  owner
  manager
  member
}

enum LocationRole {
  organizer
  participant
  viewer
}

// A group of people who share a catalog and locations. Households H3a. See
// docs/global/permissions/2026-10-04-households-design.md.
model Household {
  id          String    @id @default(cuid())
  name        String
  // Mirrors the HouseholdMember row with role owner, and is written in the same
  // transaction as that row (decision H15). The member row is the source of
  // truth for rights. Null after the owner's account is deleted, until someone
  // accepts the hand-over (H6).
  ownerId     String?
  owner       User?     @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerGoneAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members   HouseholdMember[]
  locations Location[]
  items     Item[]
  tags      Tag[]
  tagTypes  TagType[]
  vendors   Vendor[]
  recipes   Recipe[]
  shelves   Shelf[]
}

// A person's role in a household. The source of truth for household rights.
// At most one owner row per household: the add_households migration creates
// the partial unique index HouseholdMember_one_owner_key by hand, because
// Prisma has no syntax for a partial index (decision H15).
//
// The `user` relation has no onDelete, so Prisma's default (Restrict) applies:
// a User row that still has member rows cannot be deleted. Production never
// deletes a User row (H2 sets deletedAt), so such a delete is a bug and should
// fail loudly. /e2e/cleanup deletes the member rows first.
model HouseholdMember {
  householdId String
  userId      String
  role        HouseholdRole
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@id([householdId, userId])
  @@index([userId])
}

// A person's role on one location. It counts only while the person is also a
// HouseholdMember of the location's household (decision H18). Postgres cannot
// check that with a simple constraint, so requireLocationRole checks it.
// No onDelete on `user`, for the same reason as HouseholdMember.
model LocationMember {
  locationId String
  userId     String
  role       LocationRole
  createdAt  DateTime     @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([locationId, userId])
  @@index([userId])
}
