# Database — Neon PostgreSQL
# Use the POOLED connection string (has -pooler in hostname) for runtime queries
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Use the DIRECT connection string (no -pooler) for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Throwaway database used by E2E and by scripts/verify-migration.ts.
# MUST NOT point at the dev database: the migration verification drops and
# recreates the public schema, and multi-user E2E fixtures write rows that
# /e2e/cleanup (scoped to one E2E_USER_ID) will not remove.
TEST_DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb-e2e?sslmode=require"
TEST_DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb-e2e?sslmode=require"

# The LOCAL E2E database (E2E speed plan, PR B). The `cloud` E2E project uses
# it when E2E_DATABASE is unset or "local"; E2E_DATABASE=neon uses
# TEST_DATABASE_URL instead. A database on THIS computer only: the server and
# scripts/e2eLocalDb.ts refuse a host that is not localhost, 127.0.0.1, ::1 or
# a socket path, and a URL that names the same database as any other *_URL
# variable here. Form:
#   postgresql://<your mac user>@localhost:5432/p1i_e2e
# Not `postgresql://<user>@/p1i_e2e?host=/tmp` (a user with no host): Node
# does not accept it as a URL, so it is refused. Use localhost, or
# `postgresql:///p1i_e2e?host=/tmp`.
# Create it with Neon's major version and locale (PostgreSQL 17, the builtin
# provider, C.UTF-8, time zone UTC); the steps are in e2e/CLAUDE.md, *The
# local E2E database*. After EVERY new migration, run
#   pnpm --filter server e2e:db:migrate
# Once task S.8 is built, the cloud E2E run stops at the start until you do.
E2E_LOCAL_DATABASE_URL=""

# A throwaway Neon branch copied from PRODUCTION, used for migration rehearsals
# (docs/features/locations/2026-08-30-cloud-locations-design.md, section 7).
# A rehearsal answers one question: does this migration do the right thing to
# the real data shape, at the real size? A synthetic fixture cannot answer it.
#
# READ-ONLY by default. The only write a rehearsal may make is `prisma migrate
# deploy` of the migration under test, run with these two vars standing in for
# DATABASE_URL and DIRECT_URL for that one command.
#
# NEVER point `pnpm verify:migration` here. scripts/verify-migration.ts opens
# with `migrate reset`, which drops and recreates the public schema. It is
# written for TEST_DATABASE_URL and would destroy the copy under test.
#
# NEVER put the real production URL here. Copy the Neon branch first. Delete
# the branch when the rehearsal is done — Rehearsal 1's branch was deleted on
# 2026-08-30, and this one should be too.
PROD_COPY_DATABASE_URL=""
PROD_COPY_DIRECT_URL=""

# Auth
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Signing secret for the Clerk user webhook, POST /webhooks/clerk
# (src/lib/clerkWebhook.ts). Copy it from the Clerk dashboard, Webhooks, after
# adding the endpoint with the events user.created, user.updated and
# user.deleted. It starts with "whsec_". When it is empty, the route answers
# 500 to every request and writes nothing. Keep it out of the repo.
CLERK_WEBHOOK_SIGNING_SECRET=

# Server
PORT=4000

# CORS: the one browser origin allowed to call this API, besides Cloudflare
# Pages previews (see below). Set this to the production web app's origin in
# production. Defaults to http://localhost:5173 (DEFAULT_CLIENT_ORIGIN in
# src/constants.ts) if unset.
#
# Cloudflare Pages preview origins for THIS project — both per-deployment
# (https://<hash>.player1inventory.pages.dev) and per-branch
# (https://<branch>.player1inventory.pages.dev) — are allowed automatically
# by src/lib/cors.ts. No per-branch change is needed here.
CLIENT_ORIGIN=http://localhost:5173

# Testing (dev/CI only — do not set in production)
E2E_TEST_MODE=false
