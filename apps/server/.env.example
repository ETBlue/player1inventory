# Database — Neon PostgreSQL
# Use the POOLED connection string (has -pooler in hostname) for runtime queries
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Use the DIRECT connection string (no -pooler) for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Throwaway database used by E2E and by scripts/verify-migration.ts.
# MUST NOT point at the dev database: the migration verification drops and
# recreates the public schema, and multi-user E2E fixtures write rows that
# /e2e/cleanup (scoped to one E2E_USER_ID) will not remove.
TEST_DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb-e2e?sslmode=require"
TEST_DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb-e2e?sslmode=require"

# Auth
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Testing (dev/CI only — do not set in production)
E2E_TEST_MODE=false
