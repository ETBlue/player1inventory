# Database — Neon PostgreSQL
# Use the POOLED connection string (has -pooler in hostname) for runtime queries
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Use the DIRECT connection string (no -pooler) for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Throwaway database used by E2E and by scripts/verify-migration.ts.
# MUST NOT point at the dev database: the migration verification drops and
# recreates the public schema, and multi-user E2E fixtures write rows that
# /e2e/cleanup (scoped to one E2E_USER_ID) will not remove.
TEST_DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb-e2e?sslmode=require"
TEST_DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb-e2e?sslmode=require"

# A throwaway Neon branch copied from PRODUCTION, used for migration rehearsals
# (docs/features/locations/2026-08-30-cloud-locations-design.md, section 7).
# A rehearsal answers one question: does this migration do the right thing to
# the real data shape, at the real size? A synthetic fixture cannot answer it.
#
# READ-ONLY by default. The only write a rehearsal may make is `prisma migrate
# deploy` of the migration under test, run with these two vars standing in for
# DATABASE_URL and DIRECT_URL for that one command.
#
# NEVER point `pnpm verify:migration` here. scripts/verify-migration.ts opens
# with `migrate reset`, which drops and recreates the public schema. It is
# written for TEST_DATABASE_URL and would destroy the copy under test.
#
# NEVER put the real production URL here. Copy the Neon branch first. Delete
# the branch when the rehearsal is done — Rehearsal 1's branch was deleted on
# 2026-08-30, and this one should be too.
PROD_COPY_DATABASE_URL=""
PROD_COPY_DIRECT_URL=""

# Auth
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Testing (dev/CI only — do not set in production)
E2E_TEST_MODE=false
